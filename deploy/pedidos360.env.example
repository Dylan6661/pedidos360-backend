# Copiar a /etc/pedidos360/pedidos360.env en la instancia EC2 (chmod 600). NO subir el archivo real a GitHub.

# --- Microsoft Entra External ID ---
# Tenant ID: Entra admin center > Overview
IDAAS_ISSUER=https://<TENANT_ID>.ciamlogin.com/<TENANT_ID>/v2.0
IDAAS_JWKS_URI=https://<SUBDOMINIO>.ciamlogin.com/<TENANT_ID>/discovery/v2.0/keys
# Application (client) ID de la app registrada "pedidos360-api"
IDAAS_AUDIENCE=<API_CLIENT_ID>

# --- AWS RDS MySQL (una instancia, una base de datos por microservicio) ---
DB_HOST=<endpoint-rds>.rds.amazonaws.com
DB_USER=admin
DB_PASSWORD=<password>

# --- URLs internas usadas por el BFF ---
PRODUCTOS_URL=http://localhost:8081
CLIENTES_URL=http://localhost:8082
PEDIDOS_URL=http://localhost:8083
